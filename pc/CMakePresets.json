{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "cacheVariables": { 
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows (cross-compile with MinGW from WSL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "toolchainFile": "${sourceDir}/cmake/Toolchain-mingw64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SDL2_DIR": "$env{HOME}/mingw-sdl2/x86_64-w64-mingw32/lib/cmake/SDL2",
        "PC_CONSOLE": "ON",
        "PORT_GLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw"
    }
  ]
}